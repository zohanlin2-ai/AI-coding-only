/* ============================================================
   Dark Premium Theme — Local AI Image Generator
   ============================================================ */

QMainWindow {
    background-color: #121212;
}

QWidget {
    color: #E0E0E0;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* ── Prompt Input ─────────────────────────────────────────── */

QTextEdit {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 15px;
    font-size: 16px;
    color: #FFFFFF;
}

QTextEdit:focus {
    border: 1px solid #3D5AFE;
}

/* ── Buttons ──────────────────────────────────────────────── */

QPushButton {
    background-color: #3D5AFE;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #536DFE;
}

QPushButton:pressed {
    background-color: #303F9F;
}

QPushButton:disabled {
    background-color: #2A2A2A;
    color: #555555;
    border: 1px solid #3A3A3A;
}

/* Open Folder button — secondary style */
QPushButton#OpenFolderButton {
    background-color: #1E1E1E;
    color: #AAAAAA;
    border: 1px solid #444444;
    font-size: 14px;
    font-weight: normal;
    padding: 12px 18px;
}

QPushButton#OpenFolderButton:hover {
    background-color: #2A2A2A;
    border-color: #3D5AFE;
    color: #FFFFFF;
}

QPushButton#OpenFolderButton:disabled {
    background-color: #181818;
    color: #444444;
    border-color: #2A2A2A;
}

/* ── Image Display ────────────────────────────────────────── */

QLabel#ImageDisplay {
    background-color: #1A1A1A;
    border: 2px dashed #333333;
    border-radius: 15px;
    color: #555555;
    font-size: 14px;
}

QLabel#ImageDisplay:hover {
    border: 2px solid #3D5AFE;
}

/* ── Status Bar ───────────────────────────────────────────── */

QStatusBar {
    background-color: #0E0E0E;
    color: #888888;
    font-size: 12px;
    border-top: 1px solid #1E1E1E;
}

/* ── Header Labels ────────────────────────────────────────── */

#TitleLabel {
    font-size: 26px;
    font-weight: bold;
    color: #FFFFFF;
    margin-bottom: 4px;
}

#SubtitleLabel {
    font-size: 14px;
    color: #777777;
    margin-bottom: 16px;
}

/* ── Checkbox ─────────────────────────────────────────────── */

QCheckBox {
    font-size: 15px;
    color: #CCCCCC;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    border: 2px solid #3D5AFE;
    background-color: #1E1E1E;
}

QCheckBox::indicator:checked {
    background-color: #3D5AFE;
}

/* ── ComboBox ─────────────────────────────────────────────── */

QComboBox {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 15px;
    font-size: 15px;
    color: #FFFFFF;
    min-width: 260px;
}

QComboBox:hover {
    border: 1px solid #3D5AFE;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left: 1px solid #333333;
}

QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    selection-background-color: #3D5AFE;
    selection-color: #FFFFFF;
    color: #CCCCCC;
    font-size: 15px;
    outline: none;
}
